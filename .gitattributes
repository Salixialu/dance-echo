# 统一换行：源码交给 Git 自动判断，Windows 启动脚本固定 CRLF
* text=auto

*.bat text eol=crlf
*.ps1 text eol=crlf

# 二进制 / 不做换行转换（这些类型多数已不发布，留作安全网）
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.mov binary
*.mkv binary
*.webm binary
*.vrm binary
*.task binary
*.wasm binary
*.exe binary
*.pdf binary
*.docx binary
